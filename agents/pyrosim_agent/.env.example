# Copy to .env in this folder (adk loads it automatically) and set your Cloud project.
GOOGLE_CLOUD_PROJECT="YOUR-CLOUD-PROJECT"
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Newer ADK name for the same setting:
GOOGLE_GENAI_USE_ENTERPRISE=TRUE

# mock = synthetic spread in seconds; real = Earth Engine + pyretechnics (needs EE_PROJECT in repo .env)
PYROSIM_MODE=mock
# PYROSIM_AGENT_MODEL=gemini-flash-latest
